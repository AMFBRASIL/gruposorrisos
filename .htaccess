<IfModule mod_rewrite.c>
    RewriteEngine On

    # Local XAMPP em subpasta — descomente e ajuste se /material der 404:
    # RewriteBase /Sistemas/gruposorrisos/
    # Produção (app.gruposorrisos.com.br na raiz): deixe comentado ou RewriteBase /

    # HTTPS só em produção (não força em localhost)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # API, backend e arquivos estáticos — sem rewrite
    RewriteRule ^(backend|api|fornecedor|assets|uploads|vendor)(/|$) - [L,NC]

    # Opcional: /pagina.php → /pagina (se der 500 no XAMPP, deixe comentado)
    # RewriteCond %{REQUEST_FILENAME} -f
    # RewriteRule ^(.+)\.php$ $1 [R=301,L]

    # /material → material.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
